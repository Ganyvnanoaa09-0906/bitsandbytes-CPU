# ============================================================
# bitsandbytes-CPU — .gitignore
# 只提交源码/文档；编译产物、缓存、虚拟环境、模型、数据一律不入库。
# ============================================================

# ---- 编译产物 / 中间文件 ----
*.obj
*.lib
*.exp
*.dll
*.so
*.o
*.a
*.pyc
*.pyo
__pycache__/
*.egg-info/

# ---- 构建产物 ----
build/
build_linux/
build-dbg/
dist/
dist_windows/
dist_linux/
build_manual/build.log
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# ---- 灾难/发布工具编译产物(源码保留,exe 不提交) ----
tools/*.exe
tools/*.exe.manifest
selftest_cpu

# ---- 虚拟环境 / 缓存 / 训练产物 ----
.venv/
.venv_dml/
venv/
env/
env.bak/
.flash_cache/
cache_latents/
output/
rloo_out/
.prebuilt/
*.zip
*.tar.gz
*.img
*.bin

# ---- 模型 / 数据(私有,不开源) ----
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
model/
models/
textmodel/
sujvji/
data/
*.jsonl
*.parquet

# ---- 其它 ----
.idea/
.vscode/
*.swp
node_modules/

# ---- 工作区遗留物（2026-09 清理时补的）----
# .hf_home 是 HF 下载缓存（本机 580 MB），属于可再生成的缓存而不是源码；
# *.part 是没下完的分片，*.bak 是改代码前的手工备份，dist_check 是旧轮子。
# 都留在盘上，只是不参与提交。
.hf_home/
*.part
*.bak
*.bak_*
dist_check/
# 上一条会连 setup.py 注释里点名保留的两份 upstream 参考配置一起挡掉，这里放行。
!bitsandbytes/pyproject.upstream-cuda.toml.bak
!bitsandbytes/setup.upstream-cuda.py.bak

# 提交信息用的临时文件，不该进仓库
_cmsg*.txt
_tmp.txt
build_arm64/
_master_*.log
master_*.log
ofbos_*.log
gt1030/dist/
gt1030/windows_pkg/.venv/
gt1030/windows_pkg/__pycache__/
q3bit_kernel.dll
q3bit_kernel.so
q3bit_gemm.dll
q3bit_gemm.so

# 探针运行日志（不进版本库）
_igpu_*.log



# ============================================================
# 仓库卫生（2026-10-27）：实验产物一律不进版本库
# 已有一批历史产物（881 个文件）从 tree 移出，归档在仓库外：
#   D:\work\_repo_archive_2026-10-27\   （i5build 用 junction 指回，脚本里的绝对路径照旧可用）
# 结论仍然进 README / docs_cpu / 研究报告，不进仓库。
# ============================================================
i5build/
_backup_p0/
tinysd_lora/
.autopilot/
runs/
wandb/

# 运行日志 / 错误输出 / 重定向输出
*.log
*.err
*.out

# 图片：生成结果、对比图、预览图（要展示的图放 docs 或 release，不进代码库）
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ppm

# 探针/调试产物
*.exe
*.pdb
*.ilk
*.obj
*.isa
*.hsail
*.co
*.il

# 改代码前的手工备份
*.pre_*
*.PRE_*
*_backup.json
*.600step_backup.json

# 空目录占位不需要
!.gitkeep
